[Unit]
Description=Sistemler CID V6 Listener
Documentation=https://github.com/orhanyigit/sistemler-cid-linux
After=network.target

[Service]
Type=simple
ExecStart=/usr/bin/cidv6d --json
Group=cidv6d
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

# Security hardening
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/run
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target

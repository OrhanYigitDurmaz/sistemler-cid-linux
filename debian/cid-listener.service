[Unit]
Description=Sistemler CID V6 Listener
Documentation=https://github.com/orhanyigit/sistemler-cid-linux
After=network.target
ConditionPathIsExecutable=/usr/local/bin/cid-listener

[Service]
Type=simple
ExecStart=/usr/local/bin/cid-listener --json
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

# Security hardening
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/cid-listener
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
